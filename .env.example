GRAPHQL_ENDPOINT="http://example.test/wp/graphql"
WORDPRESS_URL="http://example.test"
PUBLIC_SITE_URL="https://example.com"

# Optional: CDN URL for asset rewriting (leave empty to use WordPress URLs)
CDN_URL=""

# WordPress menu slug to query
MENU_SLUG="main-menu"

# Optional: WordPress authentication for preview/draft content
WP_USERNAME=""
WP_APP_PW=""

# Shared secret for incrementing the live subscriber count on the WP backend.
# Must exactly match AN_COUNT_SECRET set in the backend (Bedrock) .env.
AN_COUNT_SECRET=""
